generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id   String @id @default(uuid())
  name String
  slug String @unique

  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  subscription Subscription?
  locations    Location[]
  machines     Machine[]
  utilityBills UtilityBill[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("MEMBER")

  accounts      Account[]
  sessions      Session[]

  // Stripe & Billing Nexus
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  isSubscribed           Boolean   @default(false)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  hasSeenOnboarding Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Keeping Subscription for detailed history if needed, or we can rely on User fields for active state checks.
// For now, let's keep it but optional/loose, or just rely on User as the source of truth for "active access".
model Subscription {
  id                   String   @id @default(uuid())
  // Link to User instead of Tenant? Or both?
  // If User is the nexus, let's link to User? 
  // But previous schema linked to Tenant. 
  // Let's leave Subscription linked to Tenant for now to avoid breaking too much, 
  // but the User fields are the PRIMARY source for the app logic as requested.
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  stripeSubscriptionId String   @unique
  status               String
  currentPeriodEnd     DateTime
  priceId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum MachineType {
  WASHER
  DRYER
}

model MachineDefinition {
  id               String    @id @default(uuid())
  brand            String
  modelNumber      String    @unique
  capacityLbs      Float?
  waterPerCycleGal Float
  energyPerCycleKwh Float     @default(0)
  gForce           Int?
  type             MachineType @default(WASHER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  machines         Machine[]
}

model Location {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  name                  String
  askingPrice           Decimal? @db.Decimal(12, 2)
  claimedMonthlyRevenue Decimal? @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  machines     Machine[]
  utilityBills UtilityBill[]

  locationIntelligence LocationIntelligence?

  address     String?
  city        String?
  state       String?
  zipCode     String?
  
  sqFt        Int?
  yearBuilt   Int?

  @@index([tenantId])
}

model LocationIntelligence {
  id         String   @id @default(uuid())
  locationId String   @unique
  location   Location @relation(fields: [locationId], references: [id])

  taxAssessments      Json?
  marketRentPsf       Float?
  commercialRent      Float?    // RentCast (Industrial/Commercial spot rent)

  censusMedianIncome  Int?
  censusPopulation    Int?
  medianAge           Float?    // Census
  populationGrowth    Float?    // Census (Growth rate or raw diff)
  housingType         Json?     // Census { singleFamily: %, multiFamily: % }

  predictedEnergyCost Float?

  intelligenceLastUpdated DateTime?
}

model Machine {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  locationId          String
  location            Location          @relation(fields: [locationId], references: [id])
  machineDefinitionId String
  machineDefinition   MachineDefinition @relation(fields: [machineDefinitionId], references: [id])
  vendPrice           Decimal           @default(0) @db.Decimal(10, 2)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  machineCycleCounts MachineCycleCount[]

  @@index([tenantId])
  @@index([locationId])
}

model UtilityBill {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  startDate     DateTime
  endDate       DateTime
  totalWaterGal Float
  totalCost     Decimal  @db.Decimal(10, 2)
  s3Key         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  machineCycleCounts MachineCycleCount[]
  auditReport        AuditReport?

  @@index([tenantId])
  @@index([locationId])
}

model MachineCycleCount {
  id            String      @id @default(uuid())
  utilityBillId String
  utilityBill   UtilityBill @relation(fields: [utilityBillId], references: [id])
  machineId     String
  machine       Machine     @relation(fields: [machineId], references: [id])
  count         Int

  @@unique([utilityBillId, machineId])
}

enum PaymentStatus {
  UNPAID
  PAID
}

model AuditReport {
  id            String      @id @default(uuid())
  utilityBillId String      @unique
  utilityBill   UtilityBill @relation(fields: [utilityBillId], references: [id])

  totalTheoreticalUsage Float
  totalActualUsage      Float
  variancePercentage    Float
  leakSuspected         Boolean

  // Valuation Metrics
  estimatedRevenue      Float   @default(0)
  valuationMultiple     Float   @default(0)

  paymentStatus   PaymentStatus @default(UNPAID)
  stripeSessionId String?

  createdAt DateTime @default(now())
}
